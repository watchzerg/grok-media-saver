{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun"]
  },
  "include": ["scripts/**/*.mjs", "src/**/*.ts", "tests/**/*.ts"]
}
