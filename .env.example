# Playwright Extension 连接凭据；勿提交真实 token。
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# 预先准备的项目 PostgreSQL 数据库；db init 只创建本项目 schema。
GROK_DB_HOST=127.0.0.1
GROK_DB_PORT=5432
GROK_DB_USER=grok_media_saver
GROK_DB_PASSWORD=
GROK_DB_NAME=grok_media_saver

# 本命令唯一支持的列表入口。
GROK_SAVED_LIST_URL=https://grok.com/imagine/saved

# 请求间隔上下限，单位为秒。
GROK_API_INTERVAL_MIN_SECONDS=5
GROK_API_INTERVAL_MAX_SECONDS=8
